##################
# Puppet managed #
##################
StrictHostKeyChecking yes
GlobalKnownHostsFile /etc/ssh/ssh_known_hosts

Host *
    ControlPath ~/.ssh/master-%r@%h:%p
    ControlMaster auto

<% @ssh_info.each do |node,port,key| -%>
Host <%= node %>
  HostName localhost
  User ssh_station
  Port <%= port %>
  HostKeyAlias <%= node %>

<% end -%>
