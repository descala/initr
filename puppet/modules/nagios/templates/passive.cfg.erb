##################
# puppet managed #
##################

define service {
    name                        passive_service
    active_checks_enabled       0
    passive_checks_enabled      1
    freshness_threshold         1800
    check_command               check_stale!1!'This service is stale'
    flap_detection_enabled      0
    register                    0
    is_volatile                 0
    check_period                24x7
    max_check_attempts          1
    normal_check_interval       5
    retry_check_interval        1
    check_freshness             0
<% if @admin_contactgroup -%>
    contact_groups              <%= @admin_contactgroup %>
<% end -%>
    check_command               check_dummy!0
    notification_interval       30
    notification_period         24x7
    notification_options        w,u,c,r
    stalking_options            w,c,u
}

# For passive checks whose single result is a sample and not a verdict. With
# max_check_attempts 1 above, one bad sample is already a hard state, so every
# blip costs two mails per contact (problem + recovery). Here Icinga waits for
# 3 consecutive bad results before it tells anybody -- there is no re-check to
# schedule (active checks are off), the soft attempts advance with each NSCA
# result that arrives, so ~15 minutes at the usual */5 cron.
# Used by the ssh check, see nagios::check.
define service {
    name                        passive_service_tolerant
    use                         passive_service
    max_check_attempts          3
    register                    0
}

define host {
        name                            passive-host
        active_checks_enabled           0
        passive_checks_enabled          1
        check_freshness                 1
        freshness_threshold             950
        check_command                   check_stale!2!'This host is stale'
        max_check_attempts              1
        register                        0
<% if @admin_contactgroup -%>
        contact_groups              <%= @admin_contactgroup %>
<% end -%>
        notification_interval           30
        notification_period             24x7
        notification_options            d,u,r
}

define command {
    command_name check_stale
    command_line $USER1$/check_dummy $ARG1$ $ARG2$
}

define command {
    command_name        check_dummy
    command_line        $USER1$/check_dummy$ARG1$
}


