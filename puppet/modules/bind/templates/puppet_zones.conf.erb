##################
# Puppet managed #
##################
# from template puppet_zones.conf.erb
# this zones are managed by initr's bind module
# you can configure them using initr

<% @bind_masterzones.each do |mz_key, mz_hash| -%>
zone "<%= mz_key %>" { type master; file "<%=scope.lookupvar('var_dir')%>/puppet_zones/<%= mz_key %>.zone";<%= mz_hash[:dnssec] ? ' inline-signing yes; dnssec-policy default;' : '' %> };
<% end -%>
