<h2><%= l(:label_dns_assignments) %></h2>

<%= form_tag({ :controller => 'dns_assignments', :action => 'index' }, :method => :get) do %>
  <p>
    <label><%= l(:label_user) %>:</label>
    <%= select_tag :user_id,
          options_from_collection_for_select(@users, :id, :name, @user&.id),
          :include_blank => true,
          :onchange => 'this.form.submit()' %>
  </p>
<% end %>

<% if @user %>
  <fieldset class="box">
    <legend><%= l(:label_dns_zones_managed_by, :name => @user.name) %></legend>

    <%# Add-zone form: the autocomplete fills #add-zone-id then submits this form. %>
    <%= form_tag({ :controller => 'dns_assignments', :action => 'add_zone', :user_id => @user.id },
                 :id => 'add-zone-form') do %>
      <p>
        <label><%= l(:label_add_zone) %>:</label>
        <%= hidden_field_tag 'zone_id', '', :id => 'add-zone-id' %>
        <input type="text" id="zone-search" autocomplete="off"
               placeholder="<%= l(:label_search_zone) %>" style="width:24em;" />
        <span id="zone-search-spinner" style="display:none;">&hellip;</span>
        <ul id="zone-search-results"
            style="list-style:none; margin:0; padding:0; border:1px solid #ccc;
                   max-width:24em; display:none; position:relative; z-index:10;
                   background:#fff;"></ul>
      </p>
    <% end %>

    <% if @bind_zones.any? %>
      <table class="list">
        <thead>
          <tr>
            <th><%= l(:field_domain) %></th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @bind_zones.each do |zone| %>
            <tr>
              <td><%= zone.domain %></td>
              <td><span style="color:#888;"><%= zone.bind&.node&.fqdn || zone.bind&.name %></span></td>
              <td class="buttons">
                <%= button_to l(:button_delete),
                      { :controller => 'dns_assignments', :action => 'remove_zone',
                        :user_id => @user.id, :zone_id => zone.id },
                      :method => :delete,
                      :class => 'icon icon-del',
                      :data => { :confirm => l(:text_are_you_sure) } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="nodata"><%= l(:label_no_zones_assigned) %></p>
    <% end %>
  </fieldset>

  <%= javascript_tag do %>
    (function() {
      var input   = document.getElementById('zone-search');
      var results = document.getElementById('zone-search-results');
      var spinner = document.getElementById('zone-search-spinner');
      var hidden  = document.getElementById('add-zone-id');
      var form    = document.getElementById('add-zone-form');
      if (!input) return;

      var searchUrl = '<%= url_for(:controller => "dns_assignments", :action => "search", :user_id => @user.id) %>';
      var timer = null;

      function clearResults() { results.innerHTML = ''; results.style.display = 'none'; }

      function render(zones) {
        results.innerHTML = '';
        if (!zones.length) { results.style.display = 'none'; return; }
        zones.forEach(function(zone) {
          var li = document.createElement('li');
          li.style.padding = '2px 6px';
          li.style.cursor = 'pointer';
          li.textContent = zone.domain + (zone.context ? ' (' + zone.context + ')' : '');
          li.addEventListener('mouseover', function() { li.style.background = '#eef'; });
          li.addEventListener('mouseout',  function() { li.style.background = ''; });
          li.addEventListener('click', function() {
            hidden.value = zone.id;
            form.submit();
          });
          results.appendChild(li);
        });
        results.style.display = 'block';
      }

      input.addEventListener('keyup', function(e) {
        if (e.key === 'Escape') { clearResults(); return; }
        var q = input.value.trim();
        clearTimeout(timer);
        if (q === '') { clearResults(); return; }
        timer = setTimeout(function() {
          spinner.style.display = 'inline';
          fetch(searchUrl + '&q=' + encodeURIComponent(q), {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
          })
            .then(function(r) { return r.json(); })
            .then(function(zones) { spinner.style.display = 'none'; render(zones); })
            .catch(function() { spinner.style.display = 'none'; clearResults(); });
        }, 250);
      });

      // Don't submit the add form on Enter (no zone picked yet).
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') e.preventDefault();
      });

      document.addEventListener('click', function(e) {
        if (e.target !== input && !results.contains(e.target)) clearResults();
      });
    })();
  <% end %>
<% end %>
