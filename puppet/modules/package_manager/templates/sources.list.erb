##################
# Puppet Managed #
##################

<% if scope.lookupvar("::lsbdistcodename") == "lenny" or (scope.lookupvar("::lsbdistcodename") == "n/a" and lsbmajdistrelease == "5") -%>
# debian leeny
deb http://archive.debian.org/debian-archive lenny main contrib non-free

<% elsif scope.lookupvar("::lsbdistcodename") == "squeeze" or (scope.lookupvar("::lsbdistcodename") == "n/a" and lsbmajdistrelease == "6") -%>
deb http://archive.debian.org/debian-archive/debian squeeze main contrib non-free
deb http://archive.debian.org/debian-archive/debian squeeze-lts main contrib non-free

<% elsif scope.lookupvar("::lsbdistcodename") == "wheezy" or (scope.lookupvar("::lsbdistcodename") == "n/a" and lsbmajdistrelease == "7") -%>
# debian wheezy
deb http://archive.debian.org/debian-archive/debian wheezy main contrib non-free
deb http://archive.debian.org/debian-security wheezy/updates main contrib non-free

<% elsif scope.lookupvar("::lsbdistcodename") == "jessie" or (scope.lookupvar("::lsbdistcodename") == "n/a" and lsbmajdistrelease == "8") -%>
# debian 8 jessie
deb http://archive.debian.org/debian-archive/debian jessie main contrib non-free
deb http://archive.debian.org/debian-security jessie/updates main contrib non-free

<% elsif scope.lookupvar("::lsbdistcodename") == "stretch" or (scope.lookupvar("::lsbdistcodename") == "n/a" and lsbmajdistrelease == "9") -%>
# debian 9 stretch
deb http://archive.debian.org/debian-archive/debian stretch main contrib non-free
deb http://archive.debian.org/debian-security stretch/updates main contrib non-free

<% elsif scope.lookupvar("::lsbdistcodename") == "buster" or (scope.lookupvar("::lsbdistcodename") == "n/a" and lsbmajdistrelease == "10") -%>
# debian 10 buster
deb http://archive.debian.org/debian-archive/debian buster main contrib non-free
deb http://archive.debian.org/debian-security buster/updates main contrib non-free

<% elsif scope.lookupvar("::lsbdistcodename") == "bullseye" or (scope.lookupvar("::lsbdistcodename") == "n/a" and lsbmajdistrelease == "11") -%>
# debian 11 bullseye (LTS ended 2026-08-31)
deb http://archive.debian.org/debian-archive/debian bullseye main contrib non-free
# bullseye-security: the final Release was signed with a Valid-Until one week
# ahead and is never refreshed, so apt rejects the repository ("Release file
# ... is expired") unless told not to check it. Then security.debian.org and
# its mirrors dropped the pool files while still publishing the index (404 on
# every .deb), before archive.debian.org carried the suite. snapshot.debian.org
# keeps the final state intact: any timestamp after the last upload resolves
# to it. Point this line at archive.debian.org/debian-security once
# dists/bullseye-security exists there (buster took ~6 months to show up).
deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260901T000000Z/ bullseye-security main contrib non-free

<% else -%>
# debian <%= scope.lookupvar("::lsbdistcodename") %>
deb http://http.debian.net/debian <%= scope.lookupvar("::lsbdistcodename") %> main contrib non-free
deb http://http.debian.net/debian <%= scope.lookupvar("::lsbdistcodename") %>-updates main contrib non-free
deb http://http.debian.net/debian <%= scope.lookupvar("::lsbdistcodename") %>-backports main contrib non-free
deb http://security.debian.org <%= scope.lookupvar("::lsbdistcodename") %>-security main contrib non-free

<% end -%>
